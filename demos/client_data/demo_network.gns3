{
  "project_id": "demo-network-001",
  "name": "Acme Corp Demo Network",
  "topology": {
    "nodes": [
      {
        "id": "router-1",
        "name": "Core Router",
        "node_type": "router",
        "properties": {
          "vendor": "cisco",
          "model": "ISR 4321"
        },
        "interfaces": [
          {
            "name": "GigabitEthernet0/0/0",
            "ipv4": "192.168.1.1/24"
          },
          {
            "name": "GigabitEthernet0/0/1",
            "ipv4": "10.0.0.1/24"
          }
        ]
      },
      {
        "id": "switch-1",
        "name": "Office Switch",
        "node_type": "switch",
        "properties": {
          "vendor": "cisco",
          "model": "Catalyst 2960"
        }
      },
      {
        "id": "server-1",
        "name": "Finance Server",
        "node_type": "server",
        "properties": {
          "os": "Windows Server 2022",
          "services": ["SQL Server", "IIS"]
        },
        "interfaces": [
          {
            "name": "eth0",
            "ipv4": "192.168.1.10/24"
          }
        ]
      },
      {
        "id": "workstation-1",
        "name": "CFO Workstation",
        "node_type": "workstation",
        "properties": {
          "os": "Windows 11",
          "user": "alice.finance@acme-corp.com"
        },
        "interfaces": [
          {
            "name": "eth0",
            "ipv4": "192.168.1.50/24"
          }
        ]
      }
    ],
    "links": [
      {
        "id": "link-1",
        "source": "router-1",
        "target": "switch-1",
        "properties": {
          "type": "ethernet"
        }
      },
      {
        "id": "link-2",
        "source": "switch-1",
        "target": "server-1",
        "properties": {
          "type": "ethernet"
        }
      },
      {
        "id": "link-3",
        "source": "switch-1",
        "target": "workstation-1",
        "properties": {
          "type": "ethernet"
        }
      }
    ]
  }
}
