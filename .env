# ============================================================================
# Vorsyghta Environment Configuration Template
# ============================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values (marked with your_*_here)
# 3. Generate secure secrets: openssl rand -hex 32
# 4. NEVER commit .env to version control
#
# ============================================================================

# ============================================================================
# OPENMP CONFLICT RESOLUTION (CRITICAL FOR macOS)
# ============================================================================
# These environment variables prevent OpenMP library conflicts on macOS
# Set these before running Vorsyghta to avoid crashes
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (disable in production!)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Docker publishes the host ports below; container ports remain fixed:
# PostgreSQL 5432, Redis 6379, Ollama 11434, API 8000, web 3000,
# Prometheus 9090, Grafana 3000, and PgAdmin 80.
POSTGRES_PORT=5433
REDIS_PORT=6380
OLLAMA_PORT=11434
API_PORT=8001
WEB_PORT=3000
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
PGADMIN_PORT=5050

# ============================================================================
# SECURITY CONFIGURATION (CRITICAL)
# ============================================================================

# JWT signing key - MUST be unique per environment
# Generate with: openssl rand -hex 32
VORSYGHTA_SECRET_KEY=test123

# Content Safety Controls
ENABLE_CONTENT_FILTERING=true
ENABLE_SAFETY_VALIDATION=true
SAFETY_SCORE_THRESHOLD=0.8
CONTENT_MODERATION=true
COMPLIANCE_MODE=true

# Audit Logging
ENABLE_AUDIT_LOGGING=true

# ============================================================================
# LLM PROVIDER API KEYS
# ============================================================================
# At least one LLM provider is required for content generation.
# Options: OpenRouter (recommended), OpenAI, Anthropic, Azure, or Ollama (local)

# OpenRouter (Recommended) - Access to multiple models
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI (Optional)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI (Optional - for enterprise)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# NVIDIA Cloud Provider
# Get your key from: https://api.nvidia.com
NVIDIA_API_KEY=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


# ============================================================================
# LOCAL LLM CONFIGURATION (Ollama)
# ============================================================================
# Enable for offline/air-gapped deployments

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:${OLLAMA_PORT}
OLLAMA_MODEL=llama3.2:1b

# ============================================================================
# LLM SETTINGS
# ============================================================================

# Default provider: openrouter, openai, anthropic, ollama, azure, nvidia
DEFAULT_LLM_PROVIDER=nvidia

# Token and rate limits
MAX_TOKENS_PER_REQUEST=4096
MAX_REQUESTS_PER_MINUTE=60
COST_LIMIT_PER_DAY=100.00

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Compose database identity and host-published connection settings.
POSTGRES_USER=vorsyghta
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=vorsyghta
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Host-published Redis connection. Containers use redis:6379 internally.
REDIS_URL=redis://localhost:${REDIS_PORT}/0
REDIS_PASSWORD=

# ============================================================================
# STRIPE BILLING
# ============================================================================

# Development: required=false, expected_livemode=false, localhost URLs allowed.
# Staging: required=true, expected_livemode=false, non-loopback HTTPS URLs.
# Production: required=true, expected_livemode=true, non-loopback HTTPS URLs.
VORSYGHTA_BILLING_REQUIRED=false
STRIPE_EXPECTED_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:${WEB_PORT}/start-trial?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:${WEB_PORT}/start-trial?checkout=canceled
STRIPE_PORTAL_RETURN_URL=http://localhost:${WEB_PORT}/app/settings/billing
# Stripe-hosted tax calculation and tax-ID collection.
STRIPE_AUTOMATIC_TAX_ENABLED=true
STRIPE_TAX_ID_COLLECTION_ENABLED=true
STRIPE_REQUEST_TIMEOUT_SECONDS=10
STRIPE_MAX_NETWORK_RETRIES=2
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origin allowed by FastAPI. The web BFF uses the private bridge URL.
ALLOWED_ORIGINS=http://localhost:${WEB_PORT}

# ============================================================================
# FILE STORAGE
# ============================================================================

TEMP_DIR=/tmp/vorsyghta
LOG_DIR=./logs
REPORT_DIR=./reports
GENERATED_CONTENT_DIR=./generated_content
OUTPUT_DIR=./output

# ============================================================================
# DATASET CONFIGURATION
# ============================================================================

VORSYGHTA_DATASETS_PATH=./data/datasets
VORSYGHTA_CACHE_PATH=./data/cache
VORSYGHTA_TEMPLATES_PATH=./templates
VORSYGHTA_SCENARIOS_PATH=./scenarios

# Dataset Settings
ENABLE_DATASET_INTEGRATION=true
AUTO_DOWNLOAD_DATASETS=false
DATASET_CACHE_TTL=86400
MAX_DATASET_SIZE_GB=5

# ============================================================================
# COMPLIANCE CONFIGURATION
# ============================================================================

ENABLE_GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365
ENABLE_ANONYMIZATION=true
AUDIT_ALL_OPERATIONS=true

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ============================================================================
# SIMULATION SETTINGS
# ============================================================================

MAX_SIMULATION_STAGES=10
MAX_CONCURRENT_SIMULATIONS=5
SIMULATION_TIMEOUT_MINUTES=30
DEFAULT_NUM_VARIATIONS=3
MAX_SIMULATION_DURATION=3600

# ============================================================================
# ENTERPRISE INTEGRATIONS (Optional)
# ============================================================================

# Microsoft 365
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Proofpoint TAP
PROOFPOINT_API_KEY=
PROOFPOINT_BASE_URL=https://tap-api-v2.proofpoint.com

# KnowBe4
KNOWBE4_API_KEY=
KNOWBE4_BASE_URL=https://us.api.knowbe4.com

# ============================================================================
# EMAIL DEPLOYMENT (Optional)
# ============================================================================

SMTP_ENABLED=true
SMTP_SERVER=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@vorsyghta.local

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Grafana and optional PgAdmin credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
GRAFANA_ROOT_URL=http://localhost:${GRAFANA_PORT}
PGADMIN_PASSWORD=your_pgadmin_password_here

# ============================================================================
# DOCKER COMPOSE SETTINGS
# ============================================================================

COMPOSE_PROJECT_NAME=vorsyghta

# ============================================================================
# PROXMOX/VM CONFIGURATION (Optional)
# ============================================================================

PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_USER=vorsyghta@pve
PROXMOX_TOKEN_NAME=automation
PROXMOX_TOKEN_VALUE=your_proxmox_token_here
PROXMOX_NODE=pve

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Hot reload (development only)
HOT_RELOAD=false
DEV_MODE=false

# Python settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Skip environment validation (development only)
SKIP_ENV_VALIDATION=false

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
#
# Before deploying to production, ensure:
#
# [ ] VORSYGHTA_SECRET_KEY is generated and unique
# [ ] DEBUG=false
# [ ] ENVIRONMENT=production
# [ ] All API keys are valid (not placeholder values)
# [ ] Database credentials are secure
# [ ] GRAFANA_ADMIN_PASSWORD is changed
# [ ] VORSYGHTA_BILLING_REQUIRED and STRIPE_EXPECTED_LIVEMODE match the deployment
# [ ] Stripe return URLs are non-loopback HTTPS URLs outside development
# [ ] ALLOWED_ORIGINS is restricted to your domain
# [ ] ENABLE_CONTENT_FILTERING=true
# [ ] ENABLE_AUDIT_LOGGING=true
#
# ============================================================================
POSTGRES_PASSWORD=devpassword
POSTGRES_USER=vorsyghta
POSTGRES_DB=vorsyghta
VORSYGHTA_SECRET_KEY=fa0b3e79de05bbf1bd33c079e22d284a29551084cc144cb137fef8dedac24802
VORSYGHTA_BILLING_REQUIRED=false
STRIPE_EXPECTED_LIVEMODE=false
GRAFANA_ADMIN_PASSWORD=admin
