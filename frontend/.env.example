# Server-only FastAPI origin. Never expose this value through a NEXT_PUBLIC variable.
VORSYGHTA_API_URL=http://localhost:8001

# Production permits cleartext HTTP only for loopback by default. Set this to true only when
# VORSYGHTA_API_URL names a trusted private service on an isolated container network.
VORSYGHTA_ALLOW_INSECURE_INTERNAL_API=false
