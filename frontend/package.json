{
  "name": "vorsyghta-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/verify-styled-jsx.mjs && next dev",
    "build": "node scripts/verify-styled-jsx.mjs && next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings src next.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
