ENVIRONMENT=production
DEBUG=false
VORSYGHTA_SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=https://app.vorsyghta.io
DJANGO_ALLOWED_HOSTS=api.vorsyghta.io,app.vorsyghta.io
DJANGO_DEBUG=false

# Backend API
VORSYGHTA_API_URL=https://api.vorsyghta.io
VORSYGHTA_ALLOW_INSECURE_INTERNAL_API=false

# Database
DATABASE_URL=postgresql://vorsyghta:${POSTGRES_PASSWORD}@postgres:5432/vorsyghta
REDIS_URL=redis://redis:6379/0

# Azure OpenAI - Vorsyghta naming
AZURE_OPENAI_ENDPOINT=https://vorsyghta-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o


# NVIDIA Cloud Provider (for Vorsyghta cloud deployment)
NVIDIA_API_KEY=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
DEFAULT_LLM_PROVIDER=nvidia
AZURE_OPENAI_API_KEY=from_key_vault

# Azure Key Vault - Vorsyghta naming
AZURE_KEY_VAULT_URL=https://vorsyghta-kv.vault.azure.net/

# Azure Resources
AZURE_RESOURCE_GROUP=vorsyghta-rg
AZURE_LOCATION=eastus2
AZURE_CONTAINER_APP_NAME=vorsyghta-api

# SIEM / EDR
SIEM_ENABLED=true
SIEM_PLATFORM=splunk
SIEM_API_URL=https://siem.vorsyghta.io
SIEM_API_KEY=from_key_vault
EDR_ENABLED=true
